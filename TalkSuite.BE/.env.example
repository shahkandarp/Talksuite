# Database
DATABASE_URL=postgresql+asyncpg://talksuite_admin:YOUR_PASSWORD@YOUR_DB_HOST:5432/talksuite

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_KNOWLEDGE_BASE_ID=your-kb-id

# MCP
NETSUITE_MCP_URL=http://localhost:8080

# NetSuite OAuth (used by scripts/get_netsuite_token.py)
NETSUITE_ACCOUNT_ID=your-account-id
NETSUITE_CLIENT_ID=your-client-id
NETSUITE_CLIENT_SECRET=your-client-secret

# App
APP_ENV=development
DEBUG=true
